{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "capture/form-submit",
  "version": "0.1.0",
  "title": "Form Submit Button",
  "category": "widgets",
  "parent": ["capture/form", "core/group", "core/column"],
  "description": "A submit button for the Capture form.",
  "attributes": {
    "text": {
      "type": "string",
      "default": "Subscribe"
    },
    "hoverBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "hoverTextColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
        "margin": true,
        "padding": true
    },
    "typography":    {
      "fontSize":   true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "__experimentalBorder": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true,
      "__experimentalDefaultControls": {
        "width": true,
        "color": true
      }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

